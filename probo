function track-runfile-impl {
    TIMESTAMP="$1"
    STATUS="$2"
    DESCRIPTION="$3"
    COMMENT="$4"
    echo ""                                        >> "$RUN_FILE"
    echo "## ${TIMESTAMP}.${STATUS}${DESCRIPTION}" >> "$RUN_FILE"
    echo ""                                        >> "$RUN_FILE"
    if [ "$COMMENT" -eq 1 ]; then
        echo "<!-- Add info here. -->"             >> "$RUN_FILE"
        echo ""                                    >> "$RUN_FILE"
    fi
}

function track-runfile {

    # -f / -d オプションの回収（あれば）
    local FORCE=0
    local DESCRIPTION=""
    while getopts "d:f" opt; do
        case $opt in
            d) DESCRIPTION="${OPTARG}" ;;
            f) FORCE=1 ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # STATUS パラメータの回収とチェック（ただし -f オプションありの場合チェックはバイパス）
    local STATUS="${1^^}"
    shift
    if [ $FORCE -eq 0 ]; then
        case $STATUS in
            READY) ;;
            BLOCK) ;;
            PASS)  ;;
            FAIL)  ;;
            RUN)   ;;
            *) echo "ERROR : invalid status \"$STATUS\"."
               return 1;;
        esac
    fi
    # 追加する行の生成
    if [ ! -z "$DESCRIPTION" ]; then
        DESCRIPTION=".$DESCRIPTION"
    fi
    local TIMESTAMP=$(date '+%Y-%m-%d-%H-%M')
    local NEW_LINE="## ${TIMESTAMP}.${STATUS}${DESCRIPTION}"

    # 対象ファイルの反復と処理
    local FILE_COUNT=0
    for RUN_FILE in $@
    do
        RUN_FILE=$(fix-runfile-name "$RUN_FILE")
        if [ ! -e "$RUN_FILE" ]; then
            echo "ERROR : runfile $RUN_FILE is not found."
        else
            track-runfile-impl "${TIMESTAMP}" "${STATUS}" "${DESCRIPTION}" 1
            FILE_COUNT=$((FILE_COUNT + 1))
        fi
    done
    echo "$FILE_COUNT file(s) updated."
}

function load-conf-file {
    local CONF_FILE="$1"

    # カレントディレクトリに conf file がなければエラー終了
    if [ ! -e "$CONF_FILE" ]; then
        echo "ERROR : $CONF_FILE missing."
        return 1
    fi

    source "$CONF_FILE"

    # PROBO_GROUPS が空ならディレクトリを走査して生成
    if [ -z "$PROBO_GROUPS" ]; then
        PROBO_GROUPS=$(find . -maxdepth 1 -type d | grep -v '^\.$' | cut -d/ -f2 | grep -v '^\.' | sort)
    fi
    # PROBO_BD_SCHEDULE が空なら生成
    if [ -z "${PROBO_BD_SCHEDULE}" ]; then
        PROBO_BD_SCHEDULE=$(generate-probo-schedule)
        if [ $? -ne 0 ]; then
            echo "ERROR : Schedule generation failed."
            return 1
        fi
    fi
    # PROBO_REPORT_TYPE の正当性チェック
    case "${PROBO_REPORT_TYPE}" in
        raw)      ;;
        markdown) ;;
        *) echo "ERROR : invalid PROBO_REPORT_TYPE variable."
           return 1;;
    esac

    return 0
}

function generate-probo-conf-file {
    local CONF_FILE="$1"
    local REPORT_TYPE="$2"
    local GNUPLOT_FLAG="$3"

    local FULLSTAT_FILE=""
    local PARTSTAT_FILE=""
    local BDDAT_FILE=""
    local SUMDAT_FILE=""
    local BDIMG_FILE=""
    local SUMIMG_FILE=""
    local DAY1=$(date -d "$(date +%Y-%m-01) +1 month"         +%Y-%m-%d)    # 翌月の初日
    local DAY2=$(date -d "$(date +%Y-%m-01) +2 month -1 days" +%Y-%m-%d)    # 翌月の末日

    if [ "$REPORT_TYPE" == "raw" ]; then
        FULLSTAT_FILE="full_stat.txt"
        PARTSTAT_FILE="part_stat.txt"
        BDDAT_FILE="burndown_data.txt"
        SUMDAT_FILE="summary.txt"
    else
        FULLSTAT_FILE="full_stat.md"
        PARTSTAT_FILE="part_stat.md"
        BDDAT_FILE=""
        SUMDAT_FILE="summary.md"
    fi
    if [ $GNUPLOT_FLAG -eq 1 ]; then
        BDIMG_FILE="burndown.svg"
        SUMIMG_FILE="summary.svg"
    fi

    cat <<EOF > "$CONF_FILE"
PROBO_REPORT_TYPE="$REPORT_TYPE"

PROBO_FULLSTAT_FILENAME="$FULLSTAT_FILE"
PROBO_FULLSTAT_INSERTION=0

PROBO_PARTSTAT_FILENAME="$PARTSTAT_FILE"
PROBO_PARTSTAT_INSERTION=0

PROBO_BDDAT_FILENAME="$BDDAT_FILE"

PROBO_SUMDAT_FILENAME="$SUMDAT_FILE"
PROBO_SUMDAT_INSERTION=0

PROBO_BDIMG_FILENAME="$BDIMG_FILE"
PROBO_BDIMG_WIDTH=
PROBO_BDIMG_HEIGHT=
PROBO_BDIMG_BGCLR=
PROBO_BDIMG_CLR_GUIDE=
PROBO_BDIMG_CLR_PASSLINE=
PROBO_BDIMG_CLR_FAILBOX=

PROBO_SUMIMG_FILENAME="$SUMIMG_FILE"
PROBO_SUMIMG_WIDTH=
PROBO_SUMIMG_HEIGHT=
PROBO_SUMIMG_BGCLR=
PROBO_SUMIMG_CLR_READY=
PROBO_SUMIMG_CLR_BLOCK=
PROBO_SUMIMG_CLR_RUN=
PROBO_SUMIMG_CLR_PASS=
PROBO_SUMIMG_CLR_FAIL=
PROBO_SUMIMG_CLR_OTHER=

PROBO_GROUPS=

PROBO_BD_STARTDAY="$DAY1"
PROBO_BD_ENDDAY="$DAY2"
PROBO_BD_EXEC_PER_DAY=5

