function probo-graph-burndown {
    # ToDo : probo-make-burndown-datafile-raw を利用するかたちにできそう
    local IMG_FILE="$1"
    local TMP_FILE="$$.bd.tmp"
    local DAT_FILE="$$.burndown.dat"
    local TODAY=$(date '+%Y-%m-%d')
    local REST1=$(find . -name '*.testcase.md' | wc -l)    # 基準線用残数
    local REST2=$REST1                                     # 実績用残数
    find . -name '*.testrun.md' | xargs grep "## ....-..-..-" > "$TMP_FILE"
    for LINE in ${PROBO_BD_SCHEDULE}
    do
        local DATE=""
        local ESTIMATED=""
        IFS=, read -r DATE ESTIMATED <<<"$LINE"
        local COUNT=""
        local NGCNT=""
        REST1=$((REST1 - ESTIMATED))
        if [ "$TODAY" "<" "$DATE" ]; then
            REST2=""
        else
            COUNT=$(cat $TMP_FILE | grep "## ${DATE}-.*\.\(PASS\|REJECT\)" | wc -l)
            NGCNT=$(cat $TMP_FILE | grep "## ${DATE}-.*\.FAIL" | wc -l)
            REST2=$((REST2 - COUNT))
        fi
        echo "${DATE},${REST1},${REST2},${NGCNT}" >> ${DAT_FILE}
    done
    IMG_TYPE=$(probo-get-image-type-from-filename "$IMG_FILE")
    probo-make-burndown-image "$DAT_FILE" "$IMG_FILE" $IMG_TYPE
    rm -f ${DAT_FILE}
    rm -f ${TMP_FILE}
}

function probo-track-runfile-impl {
    local RUN_FILE="$1"
    local TIMESTAMP="$2"
    local STATUS="$3"
    local DESCRIPTION="$4"
    local COMMENT="$5"
    echo ""                                        >> "$RUN_FILE"
    echo "## ${TIMESTAMP}.${STATUS}${DESCRIPTION}" >> "$RUN_FILE"
    echo ""                                        >> "$RUN_FILE"
    if [ "$COMMENT" -eq 1 ]; then
        echo "<!-- Add info here. -->"             >> "$RUN_FILE"
        echo ""                                    >> "$RUN_FILE"
    fi
}

function probo-track-runfile {

    # -f / -d / -e オプションの回収（あれば）
    local FORCE=0
    local EDITFILE=0
    local DESCRIPTION=""
    while getopts "d:fe" opt; do
        case $opt in
            d) DESCRIPTION="${OPTARG}" ;;
            e) EDITFILE=1 ;;
            f) FORCE=1 ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # STATUS パラメータの回収とチェック（ただし -f オプションありの場合チェックはバイパス）
    local STATUS="${1^^}"
    shift
    if [ $FORCE -eq 0 ]; then
        case $STATUS in
            READY)  ;;
            BLOCK)  ;;
            PASS)   ;;
            FAIL)   ;;
            RUN)    ;;
            REJECT) ;;
            *) echo "ERROR : invalid status \"$STATUS\"."
               return 1;;
        esac
    fi
    # 追加する行の生成
    if [ ! -z "$DESCRIPTION" ]; then
        DESCRIPTION=".$DESCRIPTION"
    fi
    local TIMESTAMP=$(date '+%Y-%m-%d-%H-%M')
    local NEW_LINE="## ${TIMESTAMP}.${STATUS}${DESCRIPTION}"

    # 対象ファイルの反復と処理
    local FILE_COUNT=0
    local LAST_FILENAME=""
    for RUN_FILE in $@
    do
        RUN_FILE=$(probo-fix-runfile-name "$RUN_FILE")
        if [ ! -e "$RUN_FILE" ]; then
            echo "ERROR : runfile $RUN_FILE is not found."
        else
            probo-track-runfile-impl "$RUN_FILE" "${TIMESTAMP}" "${STATUS}" "${DESCRIPTION}" 1
            FILE_COUNT=$((FILE_COUNT + 1))
            LAST_FILENAME="$RUN_FILE"
        fi
    done
    echo "$FILE_COUNT file(s) updated."

    if [ $EDITFILE -eq 1 ] &&  [ $FILE_COUNT -eq 1 ]; then
        probo-start-edit-impl "$RUN_FILE"
    fi
}

function probo-enum-group-dirs {
    local COUNT=0
    for DIRECTORY in $(find . -maxdepth 1 -type d | grep -v '^\.$' | cut -d/ -f2 | grep -v '^\.' | sort)
    do
        COUNT=$(ls $DIRECTORY/*.testcase.md 2> /dev/null | wc -l)
        if [ $COUNT -ne 0 ]; then
            echo "$DIRECTORY"
        fi
    done
}

function probo-load-conf-file {
    local CONF_FILE="$1"

    # カレントディレクトリに conf file がなければエラー終了
    if [ ! -e "$CONF_FILE" ]; then
        echo "ERROR : $CONF_FILE missing."
        return 1
    fi

    source "$CONF_FILE"

    # PROBO_GROUPS が空ならディレクトリを走査して生成
    # MEMO : 「PROBO_GROUPS を conf file に書いておけばそれが使われる」のは undocumented な仕様だよ
    if [ -z "$PROBO_GROUPS" ]; then
        PROBO_GROUPS=$(probo-enum-group-dirs)
    fi
    # PROBO_BD_SCHEDULE が空なら生成
    if [ -z "${PROBO_BD_SCHEDULE}" ]; then
        PROBO_BD_SCHEDULE=$(probo-make-schedule)
        if [ $? -ne 0 ]; then
            echo "ERROR : Schedule generation failed."
            return 1
        fi
    fi
    # PROBO_REPORT_TYPE の正当性チェック
    case "${PROBO_REPORT_TYPE}" in
        raw)      ;;
        markdown) ;;
        *) echo "ERROR : invalid PROBO_REPORT_TYPE variable."
           return 1;;
    esac

    PROBO_FULLSTAT_INSERTION=$(probo-choice-1st-value     "$PROBO_FULLSTAT_INSERTION"     "0")
    PROBO_PARTSTAT_INSERTION=$(probo-choice-1st-value     "$PROBO_PARTSTAT_INSERTION"     "0")
    PROBO_SUMDAT_INSERTION=$(probo-choice-1st-value       "$PROBO_SUMDAT_INSERTION"       "0")
    PROBO_GRP_FULLSTAT_INSERTION=$(probo-choice-1st-value "$PROBO_GRP_FULLSTAT_INSERTION" "0")
    PROBO_GRP_PARTSTAT_INSERTION=$(probo-choice-1st-value "$PROBO_GRP_PARTSTAT_INSERTION" "0")

    return 0
}

