#!/usr/bin/bash

function probo-show-usage {
    echo "USAGE:"
    echo "    probo --init [-c CONF_FILE] REPORT_TYPE"
    echo "    probo --ls"
    echo "    probo --log RUNFILE..."
    echo "    probo --addgrp GROUP..."
    echo "    probo --addcase [COUNT]"
    echo "    probo --edit [-c] NUMBER"
    echo "    probo --report [-q] [-c CONF_FILE]"
    echo "    probo --track [-f] [-e] [-d DESCRIPTION] STATUS RUNFILE..."
}

# 不定数のパラメータを取り、最初の存在するファイルを返す関数
function probo-1st-exist-file {
    for FILE in "$@"; do
        if [ -e "$FILE" ]; then
            echo "$FILE"
            return 0
        fi
    done    
    return 1
}

# 不定数のパラメータを取り、最初の空文字列でないものを返す関数
function probo-choice-1st-value {
    for ARG in "$@"; do
        if [ ! -z "$ARG" ]; then
            echo "$ARG"
            return 0
        fi
    done    
    return 1
}

# runfile 名の補完：４桁以下の数字列の場合のみ、カレントディレクトリにある test ID とみなす
function probo-fix-runfile-name {
    if [[ "$1" =~ ^[0-9]{1,4}$ ]]; then
        local TMP="0000${1}"
        echo "${TMP: -4}.testrun.md"
    else
        echo "$1"
    fi
}

# casefile 名の補完：４桁以下の数字列の場合のみ、カレントディレクトリにある test ID とみなす
function probo-fix-casefile-name {
    if [[ "$1" =~ ^[0-9]{1,4}$ ]]; then
        local TMP="0000${1}"
        echo "${TMP: -4}.testcase.md"
    else
        echo "$1"
    fi
}

function probo-make-schedule {

    local CURDATE="$PROBO_BD_STARTDAY"
    local ENDDATE="$PROBO_BD_ENDDAY"
    local UNIT="$PROBO_BD_EXEC_PER_DAY"
    local REST=$(find . -name '*.testcase.md' | wc -l)

    if [ -z "$CURDATE" ] || [ -z "$ENDDATE" ] || [ -z "$UNIT" ]; then
        return 1
    fi

    while :
    do
        if [ $REST -lt $UNIT ]; then
            echo "$CURDATE,$REST"
            REST=0
        else
            echo "$CURDATE,$UNIT"
            REST=$((REST - UNIT))
        fi
        if [ "$CURDATE" == "$ENDDATE" ]; then
            break
        fi
        CURDATE=$(date -d "$CURDATE + 1 day" +"%Y-%m-%d")
        if [ $? -ne 0 ]; then
            return 1
        fi
    done
}

function probo-insert-data-to-markdown-file {
    local DAT_FILE="$1"
    local OUT_FILE="$2"
    local INS_MARK="$3"
    if [ ! -e "$OUT_FILE" ]; then
        touch "$OUT_FILE"
    fi
    LINE1=$(cat "$OUT_FILE" | grep -n "<!-- begin $INS_MARK -->" | cut -d: -f1)
    LINE2=$(cat "$OUT_FILE" | grep -n "<!-- end $INS_MARK -->"   | cut -d: -f1)
    if [ -z "$LINE1" ] || [ -z "$LINE2" ]; then
        echo ""                         >> "$OUT_FILE"
        echo ""                         >> "$OUT_FILE"
        echo "<!-- begin $INS_MARK -->" >> "$OUT_FILE"
        cat  $DAT_FILE                  >> "$OUT_FILE"
        echo "<!-- end $INS_MARK -->"   >> "$OUT_FILE"
        echo ""                         >> "$OUT_FILE"
    else
        head    -$LINE1 $OUT_FILE >  $$.tmp
        cat             $DAT_FILE >> $$.tmp
        tail -n +$LINE2 $OUT_FILE >> $$.tmp
        rm -f "$OUT_FILE"
        mv $$.tmp "$OUT_FILE"
    fi
}

function probo-make-burndown-datafile-raw {
    local DAT_FILE="$1"
    local TMP_FILE="$$.bd.tmp"
    local TODAY=$(date '+%Y-%m-%d')
    local REST1=$(find . -name '*.testcase.md' | wc -l)    # 基準線用残数
    local REST2=$REST1                                     # 実績用残数
    echo "日付	期待値	PASS数	FAIL数	基準線	実績" > "${DAT_FILE}"
    find . -name '*.testrun.md' | xargs grep "## ....-..-..-" > "$TMP_FILE"
    for LINE in ${PROBO_BD_SCHEDULE}
    do
        local DATE=""
        local ESTIMATED=""
        IFS=, read -r DATE ESTIMATED <<<"$LINE"
        local COUNT=""
        local NGCNT=""
        REST1=$((REST1 - ESTIMATED))
        if [ "$TODAY" "<" "$DATE" ]; then
            REST2=""
        else
            COUNT=$(cat $TMP_FILE | grep "## ${DATE}-.*\.\(PASS\|REJECT\)" | wc -l)
            NGCNT=$(cat $TMP_FILE | grep "## ${DATE}-.*\.FAIL" | wc -l)
            REST2=$((REST2 - COUNT))
        fi
        echo "${DATE}	${ESTIMATED}	${COUNT}	${NGCNT}	${REST1}	${REST2}" >> "${DAT_FILE}"
    done
}

function probo-make-summary-datafile-raw {
    local OUT_FILE="$1"
    local INS_FLAG="$2"           # raw target では INS_FLAG は使用しない
    TOTALS=(0 0 0 0 0 0 0 0)      # READY,BLOCK,RUN,OTHER,FAIL,PASS,REJECT,TOTAL
    echo "GROUP	READY	BLOCK	RUN	OTHER	FAIL	PASS	REJECT	TOTAL	PROGRESS" > "${OUT_FILE}"
    for GROUP in ${PROBO_GROUPS}
    do
        pushd ${GROUP} > /dev/null
        COUNTS=(0 0 0 0 0 0 0 0)  # READY,BLOCK,RUN,OTHER,FAIL,PASS,REJECT,TOTAL
        for RUN_FILE in $(ls *.testrun.md)
        do
            RESULT=$(grep '^## ....-..-..-' ${RUN_FILE} | tail -1 | cut -d. -f2)
            case "${RESULT}" in
                READY )  COUNTS[0]=$((COUNTS[0] + 1));;
                BLOCK )  COUNTS[1]=$((COUNTS[1] + 1));;
                RUN )    COUNTS[2]=$((COUNTS[2] + 1));;
                FAIL )   COUNTS[4]=$((COUNTS[4] + 1));;
                PASS )   COUNTS[5]=$((COUNTS[5] + 1));;
                REJECT ) COUNTS[6]=$((COUNTS[6] + 1));;
                * )      COUNTS[3]=$((COUNTS[3] + 1));;
            esac
            COUNTS[7]=$((COUNTS[7] + 1))
        done
        local PROGRESS=$(probo-ins-pt $(( (COUNTS[5] + COUNTS[6]) * 1000 / COUNTS[7])) )
        echo "${GROUP}	${COUNTS[0]}	${COUNTS[1]}	${COUNTS[2]}	${COUNTS[3]}	${COUNTS[4]}	${COUNTS[5]}	${COUNTS[6]}	${COUNTS[7]}	${PROGRESS}%" >> ../"${OUT_FILE}"
        for ((i=0; i<8; i++)) do
            TOTALS[i]=$((TOTALS[i] + COUNTS[i]))
        done
        popd > /dev/null
    done
    local PROGRESS=$(probo-ins-pt $(( (TOTALS[5] + TOTALS[6]) * 1000 / TOTALS[7])) )
    echo "(total)	${TOTALS[0]}	${TOTALS[1]}	${TOTALS[2]}	${TOTALS[3]}	${TOTALS[4]}	${TOTALS[5]}	${TOTALS[6]}	${TOTALS[7]}	${PROGRESS}%" >> ./"${OUT_FILE}"
}

function probo-make-summary-datafile-markdown {
    local OUT_FILE="$1"
    local INS_FLAG="$2"
    # 最初に一時ファイルとして raw 形式ファイルを作成
    probo-make-summary-datafile-raw "$$.summary.raw.tmp"

    # ヘッダ行は raw file を無視して固定で出しちゃう
    echo "|GROUP|READY|BLOCK|RUN|OTHER|FAIL|PASS|REJECT|TOTAL|PROGRESS|"  > "$$.summary.tmp"
    echo "|:----|----:|----:|--:|----:|---:|---:|-----:|----:|-------:|" >> "$$.summary.tmp"

    # ２行目以降は markdown の表形式に変換（INS_FLAG に応じて分岐）
    tail -n +2 "$$.summary.raw.tmp" | perl -pe 's/	/ | /g' \
                                    | perl -pe 's/^/| /'  \
                                    | perl -pe 's/$/ |/'       >> "$$.summary.tmp"
    rm -f "$$.summary.raw.tmp"
    # INS_FLAG の値で分岐
    if [ "$INS_FLAG" -eq 1 ]; then
        # 1 なら差し込みを実施
        probo-insert-data-to-markdown-file "$$.summary.tmp" "$OUT_FILE" "probo summary"
        rm -f "$$.summary.tmp"
    else
        # 1 以外なら単純にリネーム
        mv "$$.summary.tmp" "$OUT_FILE"
    fi
}


function probo-make-status-tmpdata {
    local OUT_FILE="$1"
    echo "GROUP	CASE	TIMESTAMP	STATUS	DESCRIPTION" > $OUT_FILE
    for GROUP in ${PROBO_GROUPS}
    do
        pushd ${GROUP} > /dev/null
        for RUN_FILE in $(ls *.testrun.md)
        do
            IFS=. read -r NUMBER FTYPE SUFFIX <<<"$RUN_FILE"
            TAIL=$(grep '^## ....-..-..-' ${RUN_FILE} | tail -1)
            IFS=. read -r TIMESTAMP STATUS DESCRIPTION <<<"${TAIL:3}"
            TIMESTAMP=$(echo "$TIMESTAMP" | perl -pe 's@^(....)-(..)-(..)-(..)-(..)@\1/\2/\3 \4:\5@')
            echo "${GROUP}	${NUMBER}	${TIMESTAMP}	${STATUS}	${DESCRIPTION}" >> ../$OUT_FILE
        done
        popd > /dev/null
    done
}

function probo-make-group-status-tmpdata {
    local RAW_FILE="$1"
    local GROUP="$2"
    local OUT_FILE="$3"
    head -1                ${RAW_FILE}                      >  ${OUT_FILE}
    grep -E "^${GROUP}	"  ${RAW_FILE} | cut -d '	' -f 2- >> ${OUT_FILE}
}

function probo-make-status-file-raw {
    local FILE_MODE1="$1"    # top or group - raw target では FILE_MODE1 は使用しない
    local FILE_MODE2="$1"    # full or part
    local RAW_TMPFILE="$2"
    local OUT_FILE="$3"
    local INS_FLAG="$4"      # raw target では INS_FLAG は使用しない

    # part ファイルが指定されていれば grep -v chain で作成
    if [ "$FILE_MODE2" == "part" ]; then
        cat "${RAW_TMPFILE}" | grep -v '	PASS	' \
                             | grep -v '	REJECT	' \
                             | grep -v '	READY	' >  "${OUT_FILE}"
    fi
    # full ファイルが指定されていれば一時ファイルを単純にコピー
    if [ "$FILE_MODE2" == "full" ]; then
        cp "${RAW_TMPFILE}" "${OUT_FILE}"
    fi
}

function probo-make-status-file-markdown {
    local FILE_MODE1="$1"    # top or group
    local FILE_MODE2="$2"    # full or part
    local RAW_TMPFILE="$3"
    local OUT_FILE="$4"
    local INS_FLAG="$5"

    # ヘッダ行は raw file を無視して固定で出しちゃう（乱暴！）
    if [ "$FILE_MODE1" == "top" ]; then
        echo "| GROUP | CASE | TIMESTAMP | STATUS | DESCRIPTION |"  >  "$$.status.tmp"
        echo "|:------|:----:|:---------:|:------:|:------------|" >>  "$$.status.tmp"
    else
        echo "| CASE | TIMESTAMP | STATUS | DESCRIPTION |"  >  "$$.status.tmp"
        echo "|:----:|:---------:|:------:|:------------|" >>  "$$.status.tmp"
    fi

    # ２行目以降は markdown の表形式に変換（FILE_MODE2 に応じて分岐）
    if [ "$FILE_MODE2" == "part" ]; then
        tail -n +2 "$RAW_TMPFILE" | grep -v '	PASS	' \
                                  | grep -v '	READY	' \
                                  | grep -v '	REJECT	' \
                                  | perl -pe 's/	/ | /g' \
                                  | perl -pe 's/^/| /'  \
                                  | perl -pe 's/$/ |/'       >>  "$$.status.tmp"
    else
        tail -n +2 "$RAW_TMPFILE" | perl -pe 's/	/ | /g' \
                                  | perl -pe 's/^/| /'  \
                                  | perl -pe 's/$/ |/'       >>  "$$.status.tmp"
    fi
    # INS_FLAG の値で分岐
    if [ "$INS_FLAG" -eq 1 ]; then
        # 1 なら差し込みを実施
        probo-insert-data-to-markdown-file "$$.status.tmp" "$OUT_FILE" "probo status-${FILE_MODE2}"
        rm -f "$$.status.tmp"
    else
        # 1 以外なら単純にリネーム
        mv "$$.status.tmp" "$OUT_FILE"
    fi
}

function probo-get-image-type-from-filename {
    local IMG_TYPE="${1##*.}"    # 最後のピリオドまでを削除
    case "$IMG_TYPE" in
        svg )   ;;
        png )   ;;
        gif )   ;;
        jpeg )  ;;
        jpg )   IMG_TYPE="jpeg";;
        * )     IMG_TYPE="";;
    esac
    echo "$IMG_TYPE"
}

function probo-make-burndown-gpfile {
    local OUT_FILE="$1"
    local DAT_FILE="$2"
    local IMG_TYPE="$3"    # svg|png|jpeg|gif
    local TOP_Y1="$4"
    local TOP_Y2="$5"
    local IMG_W=$(probo-choice-1st-value "$PROBO_BDIMG_WIDTH"  "800")
    local IMG_H=$(probo-choice-1st-value "$PROBO_BDIMG_HEIGHT" "400")
    local BGCLR=$(probo-choice-1st-value "$PROBO_BDIMG_BGCLR"    "white")
    local CLR1=$(probo-choice-1st-value "$PROBO_BDIMG_CLR_GUIDE"    "gray")
    local CLR2=$(probo-choice-1st-value "$PROBO_BDIMG_CLR_PASSLINE" "blue")
    local CLR3=$(probo-choice-1st-value "$PROBO_BDIMG_CLR_FAILBOX"   "red")
    local IMG_SIZE="$IMG_W,$IMG_H"

    if [ "$IMG_TYPE" == "svg" ]; then
        echo "set terminal ${IMG_TYPE} size ${IMG_SIZE} fixed background rgb \"${BGCLR}\"" > ${OUT_FILE}
    else
        echo "set terminal ${IMG_TYPE} size ${IMG_SIZE} background rgb \"${BGCLR}\"" > ${OUT_FILE}
    fi
    
    cat >> "${OUT_FILE}" <<EOF
set datafile separator ","

# x軸が日付データであることを宣言
set xdata time
# 入力データの書式（例: 年/月/日）
set timefmt "%Y-%m-%d"
# グラフ軸の表示書式（例: 月/日）
set format x "%m/%d"

set yrange [0:${TOP_Y1}]

# 第2軸（y2軸）のメモリを表示するように設定
set ytics nomirror
set y2tics
set grid
set y2range [0:${TOP_Y2}]

# 棒グラフの幅を調整（任意）
set boxwidth 0.2 relative
set style fill solid 0.75

# 描画の実行
plot "${DAT_FILE}" using 1:2 with linespoints pt 5 ps 0.5 linecolor rgb "$CLR1" title "GuideLine", \\
     "${DAT_FILE}" using 1:3 with linespoints pt 7 ps 0.5 linecolor rgb "$CLR2" title "Pass", \\
     "${DAT_FILE}" using 1:4 with boxes       axes x1y2   linecolor rgb "$CLR3" title "Fail"
EOF
}

function probo-make-burndown-image {
    local DAT_FILE="$1"
    local OUT_FILE="$2"
    local IMG_TYPE="$3"
    # DAT_FILE を走査して TOP_Y1/TOP_Y2 を割り出す
    local TOP_Y1=$(cat $DAT_FILE | cut -d, -f2 | sort -g | tail -1)    # line graph
    local TOP_Y2=$(cat $DAT_FILE | cut -d, -f4 | sort -g | tail -1)    # Fail
    TOP_Y1=$((TOP_Y1 + 10))
    TOP_Y2=$((TOP_Y2 * 10))
    if [ $TOP_Y2 -eq 0 ]; then
        TOP_Y2=10
    fi
    # gnuplot 設定ファイルを作成
    probo-make-burndown-gpfile "$$.tmp.gp" "$DAT_FILE" ${IMG_TYPE} $TOP_Y1 $TOP_Y2
    gnuplot "$$.tmp.gp" > "${OUT_FILE}"
    rm -f "$$.tmp.gp"
}

function probo-make-summary-gpfile {
    local OUT_FILE="$1"
    local DAT_FILE="$2"
    local IMG_TYPE="$3"    # svg|png|jpeg|gif
    local IMG_W=$(probo-choice-1st-value "$PROBO_SUMIMG_WIDTH"  "500")
    local IMG_H=$(probo-choice-1st-value "$PROBO_SUMIMG_HEIGHT" "400")
    local BGCLR=$(probo-choice-1st-value "$PROBO_SUMIMG_BGCLR"       "white")
    local CLR1=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_READY"     "gray")
    local CLR2=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_BLOCK"   "purple")
    local CLR3=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_OTHER"  "#98FB98")
    local CLR4=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_FAIL"      "pink")
    local CLR5=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_RUN"       "blue")
    local CLR6=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_PASS"      "cyan")
    local CLR7=$(probo-choice-1st-value "$PROBO_SUMIMG_CLR_REJECT" "#CD9B9B")
    local IMG_SIZE="$IMG_W,$IMG_H"

    if [ "$IMG_TYPE" == "svg" ]; then
        echo "set terminal ${IMG_TYPE} size ${IMG_SIZE} fixed background rgb \"${BGCLR}\"" > ${OUT_FILE}
    else
        echo "set terminal ${IMG_TYPE} size ${IMG_SIZE} background rgb \"${BGCLR}\"" > ${OUT_FILE}
    fi
    
    cat >> "${OUT_FILE}" <<EOF
set datafile separator ","

# 角度を「度」に設定
set angles degrees

# グラフを正方形にする（円が楕円にならないようにする）
set size ratio -1

# 塗りつぶしの設定
set style fill solid 1.0 border lt -1
#set style fill solid 1.0 noborder

# 軸や目盛りを非表示にする（任意）
unset tics
unset border

# ラベルを表示する位置の半径（外半径が1の場合、0.7くらいが適当）
r_label = 0.7

set lt 1 lc rgb "$CLR1"
set lt 2 lc rgb "$CLR2"
set lt 3 lc rgb "$CLR3"
set lt 4 lc rgb "$CLR4"
set lt 5 lc rgb "$CLR5"
set lt 6 lc rgb "$CLR6"
set lt 7 lc rgb "$CLR7"

set yrange [-1.1:1.1]
set xrange [-1.1:1.1]  # x軸も同様に広げるとバランスが良くなります

# 画像の右下（完全に端）に配置
set key outside bottom right

# 描画の実行
# using 1:2:3:4:5:6 は (x:y:radius:begin:end:color) に対応
plot "${DAT_FILE}" using 1:2:3:4:5:6 with circles lc variable notitle, \\
     keyentry with boxes lt 1 title "READY", \\
     keyentry with boxes lt 2 title "BLOCK", \\
     keyentry with boxes lt 3 title "OTHER", \\
     keyentry with boxes lt 4 title "FAIL", \\
     keyentry with boxes lt 5 title "RUN", \\
     keyentry with boxes lt 6 title "PASS", \\
     keyentry with boxes lt 7 title "REJECT", \\
     "${DAT_FILE}" using \\
     (\$1 + r_label * cos((\$4+\$5)/2.0)) : \\
     (\$2 + r_label * sin((\$4+\$5)/2.0)) : \\
     (stringcolumn(7)) with labels center font ",12" tc rgb "black" notitle
EOF
}

function probo-ins-pt {
    local NUM="$1"
    if [ "${#NUM}" -eq 1 ]; then
        echo "0.$NUM"
    else
        echo "${NUM%?}.${NUM#${NUM%?}}"
    fi
}

function probo-make-summary-image {
    local OUT_FILE="$1"
    local IMG_TYPE="$2"
    local CASES=("$3" "$4" "$5" "$6" "$7" "$8" "$9") # READY,BLOCK,OTHER,FAIL,RUN,PASS,REJECT

    local N_TOTAL=$((CASES[0] + CASES[1] + CASES[2] + CASES[3] + CASES[4] + CASES[5] + CASES[6]))
    local DEG1=0

    echo "# 中心X  中心Y  半径  開始角  終了角  色番号  表示する値" >  "$$.tmp.dat"
    for ((i=0; i<7; i++)) do
        local DEGREE=$((CASES[i] * 3600 / N_TOTAL))
        if [ "${CASES[i]}" -ne 0 ]; then
            local DEG2=$((DEG1 + DEGREE))
            echo "0,0,1,$(probo-ins-pt ${DEG1}),$(probo-ins-pt ${DEG2}),$((i + 1)),${CASES[i]}" >> "$$.tmp.dat"
            DEG1=${DEG2}
        fi
    done

    # gnuplot 設定ファイルを作成
    probo-make-summary-gpfile "$$.tmp.gp" "$$.tmp.dat" ${IMG_TYPE}
    gnuplot "$$.tmp.gp" > "${OUT_FILE}"
    rm -f "$$.tmp.gp"
    rm -f "$$.tmp.dat"
}

function probo-graph-summary {
    local OUT_FILE="$1"
    COUNTS=(0 0 0 0 0 0 0)    # READY,BLOCK,FAIL,RUN,PASS,REJECT,OTHER
    for GROUP in ${PROBO_GROUPS}
    do
        pushd ${GROUP} > /dev/null
        for RUN_FILE in $(ls *.testrun.md)
        do
            RESULT=$(grep '^## ....-..-..-' ${RUN_FILE} | tail -1 | cut -d. -f2)
            case "${RESULT}" in
                READY )  COUNTS[0]=$((COUNTS[0] + 1));;
                BLOCK )  COUNTS[1]=$((COUNTS[1] + 1));;
                FAIL )   COUNTS[2]=$((COUNTS[2] + 1));;
                RUN )    COUNTS[3]=$((COUNTS[3] + 1));;
                PASS )   COUNTS[4]=$((COUNTS[4] + 1));;
                REJECT ) COUNTS[5]=$((COUNTS[5] + 1));;
                * )      COUNTS[6]=$((COUNTS[6] + 1));;
            esac
        done
        popd > /dev/null
    done
    IMG_TYPE=$(probo-get-image-type-from-filename "$OUT_FILE")
    probo-make-summary-image "$OUT_FILE" $IMG_TYPE \
                             ${COUNTS[0]} ${COUNTS[1]} ${COUNTS[6]} \
                             ${COUNTS[2]} ${COUNTS[3]} ${COUNTS[4]} ${COUNTS[5]}
    rm -f ${DAT_FILE}
}

