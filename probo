EOF
}

function initialize-probo {

    # -c オプションの回収（あれば）
    local CONF_FILE="probo.conf"
    while getopts "c:" opt; do
        case $opt in
            c) CONF_FILE="${OPTARG}" ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # カレントディレクトリに指定 conf file がすでにあればエラー
    if [ -e "$CONF_FILE" ]; then
        echo "ERROR : $CONF_FILE has already exists."
        exit 1
    fi

    local REPORT_TYPE="$1"
    # REPORT_TYPE の正当性チェック
    case "${REPORT_TYPE}" in
        raw)      ;;
        markdown) ;;
        *) echo "ERROR : invalid REPORT_TYPE parameter."
           return 1;;
    esac
    shift 1

    generate-probo-conf-file "$CONF_FILE" "$REPORT_TYPE" $(which gnuplot | wc -l)

    local GROUP_NAME="$1"
    while [ ! -z "$GROUP_NAME" ]; do
        if [ ! -d "$GROUP_NAME" ]; then
            mkdir "./$GROUP_NAME"
        fi
        shift 1
        GROUP_NAME="$1"
    done
    
}

function add-test-case-impl {
    local ID="0000${1}"
    local GROUP="$2"
    local TIMESTAMP="$3"
    local CASE_TMPL="$4"
    ID="${ID: -4}"
    CASE_FILE="$ID.testcase.md"
    RUN_FILE="$ID.testrun.md"
    echo "Adding test case $ID..."
    if [ -z "$CASE_TMPL" ]; then
        touch "$CASE_FILE"
    else
        cat "$CASE_TMPL" | perl -pe "s/%CASEID%/${ID}/g"   \
                         | perl -pe "s/%GROUP%/${GROUP}/g" > "$CASE_FILE"
    fi   
    track-runfile-impl "$TIMESTAMP" "NEW" "" 0
}

function add-test-case {
    local COUNT="$1"
    if [ -z "$COUNT" ]; then
        COUNT=1
    fi
    if [[ ! "$COUNT" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR : invalid parameter \"$COUNT\"."
        return 1
    fi
    local CASE_TMPL=$(first-exist-file "./.case.template" "../.case.template")
    local GROUP=$(basename $(pwd))
    local TIMESTAMP=$(date '+%Y-%m-%d-%H-%M')
    local CURTAIL=0
    if [ $(ls *.testcase.md 2> /dev/null | wc -l) -ne 0 ]; then
        CURTAIL=$(ls *.testcase.md | sort | tail -1 | cut -d. -f1)
    fi
    local COUNT=$((10#$COUNT))
    CURTAIL=$((10#$CURTAIL))
    for ((i=0; i<$COUNT; i++)) do
        add-test-case-impl $((CURTAIL + 1 + i)) "$GROUP" "$TIMESTAMP" "$CASE_TMPL"
    done
}

function dump-runfile-log {
    for RUN_FILE in $@
    do
        RUN_FILE=$(fix-runfile-name "$RUN_FILE")
        if [ ! -e "$RUN_FILE" ]; then
            echo "ERROR : runfile $RUN_FILE is not found."
        else
            TEST_ID=$(echo "$RUN_FILE" | perl -pe 's/^(.+?)\.testrun\.md$/\1/')
            while IFS= read -r LINE; do
                TIMESTAMP=$(  echo "${LINE:3}" | cut -d. -f1)
                STATUS=$(     echo "${LINE:3}" | cut -d. -f2)
                DESCRIPTION=$(echo "${LINE:3}" | cut -d. -f3)
                echo "${TEST_ID}	${TIMESTAMP}	${STATUS}	${DESCRIPTION}"
            done < <(grep -E '^## ....-..-..-..-..\..+' "$RUN_FILE" )
        fi
    done
}

function dump-current-group-status {
    echo "CASE	TIMESTAMP	STATUS	DESRIPTION"
    for RUN_FILE in $(ls *.testrun.md)
    do
        NUMBER=$(echo "$RUN_FILE" | cut -d. -f1)
        TAIL=$(grep '^## ....-..-..-' ${RUN_FILE} | tail -1)
        TIMESTAMP=$(echo ${TAIL:3} | cut -d. -f1 | perl -pe 's@^(....)-(..)-(..)-(..)-(..)@\1/\2/\3 \4:\5@')
        STATUS=$(     echo ${TAIL} | cut -d. -f2)
        DESCRIPTION=$(echo ${TAIL} | cut -d. -f3)
        echo "${NUMBER}	${TIMESTAMP}	${STATUS}	${DESCRIPTION}"
    done
}

function generate-report-files-raw {

    # status file 指定があれば生成（raw target では insertion 指定は無視）
    if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ] || [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
        # 最初に一時ファイルとして作成
        generate-status-file-raw "$$.status.tmp"
        # pickup ファイルが指定されていれば grep -v chain で作成
        if [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
            cat "$$.status.tmp" | grep -v '	PASS	' \
                                | grep -v '	READY	' >  "${PROBO_PARTSTAT_FILENAME}"
        fi
        # full ファイルが指定されていれば mv で一時ファイルを rename
        if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ]; then
            mv "$$.status.tmp" "${PROBO_FULLSTAT_FILENAME}"
        else
            # 指定なしなら一時ファイルを削除
            rm -f "$$.status.tmp"
        fi
    fi
    # burn-down data file 指定があれば生成
    if [ ! -z "${PROBO_BDDAT_FILENAME}" ]; then
        generate-burndown-data-file-raw "${PROBO_BDDAT_FILENAME}"
    fi
    # summary data file 指定があれば生成（raw target では insertion 指定は無視）
    if [ ! -z "${PROBO_SUMDAT_FILENAME}" ]; then
        generate-summary-data-file-raw "${PROBO_SUMDAT_FILENAME}"
    fi
	# ファイル名が指定されている場合のみグラフ生成
    if [ ! -z "$PROBO_BDIMG_FILENAME" ]; then
        graph-burndown "$PROBO_BDIMG_FILENAME"
    fi
    if [ ! -z "$PROBO_SUMIMG_FILENAME" ]; then
        graph-summary "$PROBO_SUMIMG_FILENAME"
    fi

	return 0
}

function generate-report-files-markdown {

    # status file 指定があれば生成
    if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ] || [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
        # 最初に一時ファイルとして raw 形式ファイルを作成
        generate-status-file-raw "$$.status.raw.tmp"
        # pickup ファイルが指定されていれば作成
        if [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
            generate-status-file-markdown 'pickup' "$$.status.raw.tmp" \
                                          "$PROBO_PARTSTAT_FILENAME" "$PROBO_PARTSTAT_INSERTION"
        fi
        # full ファイルが指定されている場合
        if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ]; then
            generate-status-file-markdown 'full' "$$.status.raw.tmp" \
                                          "$PROBO_FULLSTAT_FILENAME" "$PROBO_FULLSTAT_INSERTION"
        fi
        # 一時ファイルを削除
        rm -f "$$.status.raw.tmp"
    fi
    # burn-down data file 指定があれば生成
    if [ ! -z "${PROBO_BDDAT_FILENAME}" ]; then
        generate-burndown-data-file-raw "${PROBO_BDDAT_FILENAME}"
    fi
    # summary data file 指定があれば生成
    if [ ! -z "${PROBO_SUMDAT_FILENAME}" ]; then
        generate-summary-data-file-markdown "$PROBO_SUMDAT_FILENAME" "$PROBO_SUMDAT_INSERTION"
    fi
	# ファイル名が指定されている場合のみグラフ生成
    if [ ! -z "$PROBO_BDIMG_FILENAME" ]; then
        graph-burndown "$PROBO_BDIMG_FILENAME"
    fi
    if [ ! -z "$PROBO_SUMIMG_FILENAME" ]; then
        graph-summary "$PROBO_SUMIMG_FILENAME"
    fi

	return 0
}

function generate-reports {

    CONF_FILE="./probo.conf"

    # -c オプションの回収（あれば）
    while getopts "c:" opt; do
        case $opt in
            c) CONF_FILE="${OPTARG}" ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # loading conf file 
    load-conf-file "$CONF_FILE"
    if [ $? -ne 0 ]; then
        return 1
    fi

    if [ "$MODE" == "--report" ]; then

        # gnuplot 要否、および存在チェック
        if [ ! -z "$PROBO_BDIMG_FILENAME" ] || [ ! -z "$PROBO_SUMIMG_FILENAME" ]; then
            if [ $(which gnuplot | wc -l) -eq 0 ]; then
                echo "ERROR : gnuplot is missing."
                return 1
            fi
        fi
        generate-report-files-${PROBO_REPORT_TYPE}
    fi

}

MODE="$1"
shift

# モード指定がなければ show-usage して終わり
if [ -z "$MODE" ]; then
    show-usage
    exit 1
fi

# モード指定で分岐
case "$MODE" in
    --help )    show-usage
                exit 0;;
    --init )    initialize-probo "$@"
                exit 0;;
    --ls )      dump-current-group-status
                exit 0;;
    --log )     dump-runfile-log "$@"
                exit 0;;
    --track )   track-runfile "$@"
                exit 0;;
    --addcase ) add-test-case "$@"
                exit 0;;
    --report )  generate-reports "$@"
                exit 0;;
    * )         echo "ERROR: Invalid option \"$MODE\"."
                echo ""
                show-usage
                exit 1;;
esac

