function probo-initialize {

    # -c オプションの回収（あれば）
    local CONF_FILE="probo.conf"
    while getopts "c:" opt; do
        case $opt in
            c) CONF_FILE="${OPTARG}" ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # カレントディレクトリに指定 conf file がすでにあればエラー
    if [ -e "$CONF_FILE" ]; then
        echo "ERROR : $CONF_FILE has already exists."
        exit 1
    fi

    local ORG_TYPE="${1,,}"
    local REPORT_TYPE="${1,,}"
    # REPORT_TYPE の正当性チェック
    case "${ORG_TYPE}" in
        raw)      ;;
        markdown) ;;
        gitlab)   REPORT_TYPE="markdown";;
        github)   REPORT_TYPE="markdown";;
        turnup)   REPORT_TYPE="markdown";;
        *) echo "ERROR : invalid REPORT_TYPE parameter."
           return 1;;
    esac
    shift 1

    probo-make-conf-file "$CONF_FILE" "$REPORT_TYPE" $(which gnuplot | wc -l)
    probo-make-case-template-file

    if [ "${ORG_TYPE}" == "gitlab" ] || [ "${ORG_TYPE}" == "github" ]; then
        probo-make-group-readme-template-file
    fi

}

function probo-add-group {

    local README_FILE="README.md"
    local TMPL_FILE="./.group.readme.template"
    if [ ! -e "$TMPL_FILE" ]; then
        TMPL_FILE=""
    fi

    local GROUP_NAME="$1"
    while [ ! -z "$GROUP_NAME" ]; do
        if [ ! -d "$GROUP_NAME" ]; then
            mkdir "./$GROUP_NAME"
        fi
        if [ -d "$GROUP_NAME" ] && [ ! -z "$TMPL_FILE" ]; then
            cat "$TMPL_FILE" | perl -pe "s/%GROUP%/${GROUP_NAME}/g" \
                                              > "./${GROUP_NAME}/${README_FILE}"
        fi
        shift 1
        GROUP_NAME="$1"
    done
    
}

function probo-add-case-impl {
    local ID="0000${1}"
    local GROUP="$2"
    local TIMESTAMP="$3"
    local CASE_TMPL="$4"
    ID="${ID: -4}"
    local CASE_FILE="$ID.testcase.md"
    local RUN_FILE="$ID.testrun.md"
    echo "Adding test case $ID..."
    if [ -z "$CASE_TMPL" ]; then
        touch "$CASE_FILE"
    else
        cat "$CASE_TMPL" | perl -pe "s/%CASEID%/${ID}/g"   \
                         | perl -pe "s/%GROUP%/${GROUP}/g" > "$CASE_FILE"
    fi   
    probo-track-runfile-impl "$RUN_FILE" "$TIMESTAMP" "NEW" "" 0
}

function probo-add-case {
    local COUNT="$1"
    if [ -z "$COUNT" ]; then
        COUNT=1
    fi
    if [[ ! "$COUNT" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR : invalid parameter \"$COUNT\"."
        return 1
    fi
    local CASE_TMPL=$(probo-1st-exist-file "./.case.template" "../.case.template")
    local GROUP=$(basename $(pwd))
    local TIMESTAMP=$(date '+%Y-%m-%d-%H-%M')
    local CURTAIL=0
    if [ $(ls *.testcase.md 2> /dev/null | wc -l) -ne 0 ]; then
        CURTAIL=$(ls *.testcase.md | sort | tail -1 | cut -d. -f1)
    fi
    local COUNT=$((10#$COUNT))
    CURTAIL=$((10#$CURTAIL))
    for ((i=0; i<$COUNT; i++)) do
        probo-add-case-impl $((CURTAIL + 1 + i)) "$GROUP" "$TIMESTAMP" "$CASE_TMPL"
    done
}

function probo-dump-log {
    for RUN_FILE in $@
    do
        RUN_FILE=$(probo-fix-runfile-name "$RUN_FILE")
        if [ ! -e "$RUN_FILE" ]; then
            echo "ERROR : runfile $RUN_FILE is not found."
        else
            TEST_ID=$(echo "$RUN_FILE" | perl -pe 's/^(.+?)\.testrun\.md$/\1/')
            while IFS= read -r LINE; do
                IFS=. read -r TIMESTAMP STATUS DESCRIPTION <<<"${LINE:3}"
                echo "${TEST_ID}	${TIMESTAMP}	${STATUS}	${DESCRIPTION}"
            done < <(grep -E '^## ....-..-..-..-..\..+' "$RUN_FILE" )
        fi
    done
}

function probo-list-group-status {
    local GROUP="$1"
    if [ ! -z "$GROUP" ]; then
        GROUP="$GROUP	"
    fi
    for RUN_FILE in $(ls *.testrun.md)
    do
        IFS=. read -r NUMBER FTYPE SUFFIX <<<"$RUN_FILE"
        TAIL=$(grep '^## ....-..-..-' ${RUN_FILE} | tail -1)
        IFS=. read -r TIMESTAMP STATUS DESCRIPTION <<<"${TAIL:3}"
        TIMESTAMP=$(echo "$TIMESTAMP" | perl -pe 's@^(....)-(..)-(..)-(..)-(..)@\1/\2/\3 \4:\5@')
        echo "${GROUP}${NUMBER}	${TIMESTAMP}	${STATUS}	${DESCRIPTION}"
    done
}

function probo-list-status {
    local COUNT=$(ls *.testrun.md 2> /dev/null | wc -l)
    if [ $COUNT -ne 0 ]; then
        echo "CASE	TIMESTAMP	STATUS	DESCRIPTION"
        probo-list-group-status
    else
        echo "GROUP	CASE	TIMESTAMP	STATUS	DESCRIPTION"
        local GRPS=$(probo-enum-group-dirs)
        for GROUP in ${GRPS}
        do
            pushd "$GROUP" > /dev/null
            probo-list-group-status "$GROUP"
            popd > /dev/null
        done
    fi
}

function probo-start-edit-impl {
    local TARGET="$1"
    local EDITCMD=""
    if [ -z "$PROBO_EDITOR" ]; then
        EDITCMD="vi ~1"
    else
        EDITCMD="$PROBO_EDITOR"
    fi
    eval "${EDITCMD/~1/$TARGET}"  2> /dev/null
}

function probo-start-edit {
    local CASEEDIT=0
    while getopts "c" opt; do
        case $opt in
            c) CASEEDIT=1 ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))
    local TARGET="$1"
    if [ -z "$TARGET" ]; then
        echo "ERROR : Edit target missing."
        return 1
    fi
    if [ $CASEEDIT -eq 0 ]; then
        TARGET=$(probo-fix-runfile-name "$TARGET")
    else
        TARGET=$(probo-fix-casefile-name "$TARGET")
    fi
    if [ ! -e "$TARGET" ]; then
        echo "ERROR : File $TARGET is not exists."
        return 1
    fi
    probo-start-edit-impl "$TARGET"
}

function probo-progress-notifier {
    echo "$1"
}

function probo-progress-notifier-none {
    echo "$1" > /dev/null
}

function probo-make-report-files {

    local TARGET="$1"
    local BE_QUIET="$2"
    local PROGRESS_NOTIFIER=probo-progress-notifier
    if [ $BE_QUIET -eq 1 ]; then
        PROGRESS_NOTIFIER=probo-progress-notifier-none
    fi
    # 必要ならステータス一覧の一時ファイルを最初に作成
    if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ]     || [ ! -z "${PROBO_PARTSTAT_FILENAME}" ] || \
       [ ! -z "${PROBO_GRP_FULLSTAT_FILENAME}" ] || [ ! -z "${PROBO_GRP_PARTSTAT_FILENAME}" ]; then
        ${PROGRESS_NOTIFIER} "preparing status list..."
        probo-make-status-tmpdata "$$.status.rawdata"
    fi
    # top status file 指定があれば生成
    if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ] || [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
        ${PROGRESS_NOTIFIER} "generating status data..."
        # part ファイルが指定されていれば作成
        if [ ! -z "${PROBO_PARTSTAT_FILENAME}" ]; then
            probo-make-status-file-${TARGET} 'top' 'part' "$$.status.rawdata" \
                                             "$PROBO_PARTSTAT_FILENAME" "$PROBO_PARTSTAT_INSERTION"
        fi
        # full ファイルが指定されていれば作成
        if [ ! -z "${PROBO_FULLSTAT_FILENAME}" ]; then
            probo-make-status-file-${TARGET} 'top' 'full' "$$.status.rawdata" \
                                             "$PROBO_FULLSTAT_FILENAME" "$PROBO_FULLSTAT_INSERTION"
        fi
    fi
    # group status file 指定があれば生成
    if [ ! -z "${PROBO_GRP_FULLSTAT_FILENAME}" ] || [ ! -z "${PROBO_GRP_PARTSTAT_FILENAME}" ]; then
        ${PROGRESS_NOTIFIER} "generating group status data..."
        for GROUP in ${PROBO_GROUPS}
        do
            probo-make-group-status-tmpdata "$$.status.rawdata" "$GROUP" "$$.grp.status.rawdata"
            # part ファイルが指定されていれば作成
            if [ ! -z "${PROBO_GRP_PARTSTAT_FILENAME}" ]; then
                probo-make-status-file-${TARGET} 'group' 'part' \
                                                 "$$.grp.status.rawdata" \
                                                 "$GROUP/$PROBO_GRP_PARTSTAT_FILENAME" \
                                                 "$PROBO_GRP_PARTSTAT_INSERTION"
            fi
            # full ファイルが指定されていれば作成
            if [ ! -z "${PROBO_GRP_FULLSTAT_FILENAME}" ]; then
                probo-make-status-file-${TARGET} 'group' 'full' \
                                                 "$$.grp.status.rawdata" \
                                                 "$GROUP/$PROBO_GRP_FULLSTAT_FILENAME" \
                                                 "$PROBO_GRP_FULLSTAT_INSERTION"
            fi
            rm -f "$$.grp.status.rawdata"
        done
    fi
    # 一時ファイルが存在していれば削除
    if [ -e "$$.status.rawdata" ]; then
        rm -f "$$.status.rawdata"
    fi
    # burn-down data file 指定があれば生成（これは常に raw 形式）
    if [ ! -z "${PROBO_BDDAT_FILENAME}" ]; then
        ${PROGRESS_NOTIFIER} "generating burndown data..."
        probo-make-burndown-datafile-raw "${PROBO_BDDAT_FILENAME}"
    fi
    # summary data file 指定があれば生成
    if [ ! -z "${PROBO_SUMDAT_FILENAME}" ]; then
        ${PROGRESS_NOTIFIER} "generating summary data..."
        probo-make-summary-datafile-${TARGET} "$PROBO_SUMDAT_FILENAME" "$PROBO_SUMDAT_INSERTION"
    fi
    # ファイル名が指定されている場合のみグラフイメージ生成
    if [ ! -z "$PROBO_BDIMG_FILENAME" ]; then
        ${PROGRESS_NOTIFIER} "generating burndown image..."
        probo-graph-burndown "$PROBO_BDIMG_FILENAME"
    fi
    if [ ! -z "$PROBO_SUMIMG_FILENAME" ]; then
        ${PROGRESS_NOTIFIER} "generating summary image..."
        probo-graph-summary "$PROBO_SUMIMG_FILENAME"
    fi
    if [ ! -z "$PROBO_GRP_SUMIMG_FILENAME" ]; then
        ${PROGRESS_NOTIFIER} "generating group summary image..."
        for GROUP in ${PROBO_GROUPS}
        do
            probo-graph-group-summary "$GROUP" "$PROBO_GRP_SUMIMG_FILENAME"
        done
    fi

    return 0
}

function probo-make-reports {

    local BE_QUIET=0
    local CONF_FILE="./probo.conf"

    # -c  -q オプションの回収（あれば）
    while getopts "c:q" opt; do
        case $opt in
            c) CONF_FILE="${OPTARG}" ;;
            q) BE_QUIET=1 ;;
            *) echo "ERROR : invalid option."
               return 1;;
        esac
    done
    shift $((OPTIND - 1))

    # loading conf file 
    probo-load-conf-file "$CONF_FILE"
    if [ $? -ne 0 ]; then
        return 1
    fi

    # gnuplot 要否、および存在チェック
    if [ ! -z "$PROBO_BDIMG_FILENAME" ] || [ ! -z "$PROBO_SUMIMG_FILENAME" ]; then
        if [ $(which gnuplot | wc -l) -eq 0 ]; then
            echo "ERROR : gnuplot is missing."
            return 1
        fi
    fi
    probo-make-report-files ${PROBO_REPORT_TYPE} $BE_QUIET
    return 0
}

MODE="$1"
shift

# モード指定がなければ show-usage して終わり
if [ -z "$MODE" ]; then
    probo-show-usage
    exit 1
fi

# モード指定で分岐
case "$MODE" in
    --help )    probo-show-usage
                exit 0;;
    --init )    probo-initialize "$@"
                exit 0;;
    --ls )      probo-list-status
                exit 0;;
    --log )     probo-dump-log "$@"
                exit 0;;
    --track )   probo-track-runfile "$@"
                exit 0;;
    --addgrp )  probo-add-group "$@"
                exit 0;;
    --addcase ) probo-add-case "$@"
                exit 0;;
    --edit )    probo-start-edit "$@"
                exit 0;;
    --report )  probo-make-reports "$@"
                exit 0;;
    * )         echo "ERROR: Invalid option \"$MODE\"."
                echo ""
                probo-show-usage
                exit 1;;
esac

